<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>StunServer</AssemblyName>
		<!--<PublishAot>true</PublishAot>
		<PublishTrimmed>true</PublishTrimmed>-->
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.12" />
		<PackageReference Include="System.CommandLine" Version="2.0.12" />
		<PackageReference Include="Tmds.Systemd.Logging" Version="0.8.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)'=='Debug'">
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Wodsoft.StunServer.Core\Wodsoft.StunServer.Core.csproj" />
	</ItemGroup>
</Project>
